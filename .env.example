# ZYRA environment configuration — copy to `.env` and fill in real values.
#
# The `.env` file is read automatically at startup (python-dotenv) and is
# never committed. Never hard-code API keys in the source.

# ── VirusTotal (phishing / malware reputation for link analysis + URL Analyzer) ──
# Get a free key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# ── Optional: Google Safe Browsing alternative (used only if VT is absent) ──
GOOGLE_SAFE_BROWSING_API_KEY=

# ── Optional: force a provider: virustotal | google_safe_browsing | none ──
# THREAT_INTEL_PROVIDER=virustotal
# Generic key used when THREAT_INTEL_PROVIDER is forced explicitly.
# THREAT_INTEL_API_KEY=

# ── Optional: ML phishing classifier ──
# Set to 1 to disable the local ML classifier; or point to a custom model:
# ZYRA_ML_DISABLE=0
# ZYRA_ML_MODEL=
