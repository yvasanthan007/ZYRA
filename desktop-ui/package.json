{
  "name": "zyra-desktop-ui",
  "version": "1.0.0",
  "description": "Desktop UI for ZYRA AI Assistant",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "webpack --config webpack.config.js --env target=main",
    "build:preload": "webpack --config webpack.config.js --env target=preload",
    "build:renderer": "webpack --config webpack.config.js --env target=renderer",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "lint": "tsc --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --publish=never",
    "dist:mac": "npm run build && electron-builder --mac --publish=never",
    "dist:linux": "npm run build && electron-builder --linux --publish=never",
    "package": "electron-builder --mac --win --linux --publish=never"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "css-loader": "^6.8.0",
    "electron": "^43.2.0",
    "electron-builder": "^25.0.0",
    "electron-context-menu": "^3.0.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "electron-log": "^5.3.0",
    "electron-updater": "^6.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.zyra.ai-assistant",
    "productName": "ZYRA",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "../backend/**/*",
      "../brain.py",
      "../speak.py",
      "../listen.py",
      "../memory.py",
      "../commands/**/*",
      "../link_analysis.py",
      "../zyra_handler.py",
      "../screen_ocr.py",
      "../requirements.txt"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico",
      "publisherName": "ZYRA AI Assistant",
      "verifyUpdateCode": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZYRA AI Assistant",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInject": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons/icon.png",
      "category": "Development",
      "maintainer": "ZYRA"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ZyraAI",
        "repo": "zyra-desktop"
      }
    ]
  }
}
