{
  "name": "zyra-desktop-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop UI for ZYRA AI Assistant",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "webpack --config webpack.config.js --env target=main",
    "build:preload": "webpack --config webpack.config.js --env target=preload",
    "build:renderer": "webpack --config webpack.config.js --env target=renderer",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "electron ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "css-loader": "^6.8.0",
    "electron": "^43.2.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
